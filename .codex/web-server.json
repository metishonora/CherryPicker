{
  "schemaVersion": 1,
  "projectId": "cherrypicker",
  "stateDirectory": ".codex-tmp/web-servers",
  "startTimeoutMs": 10000,
  "port": {
    "issueBase": 11000,
    "fallbackBase": 12000,
    "fallbackSpan": 1000
  },
  "profiles": [
    {
      "namePattern": "^prototype$",
      "command": [
        "python3",
        "-m",
        "http.server",
        "{port}",
        "--bind",
        "{host}",
        "--directory",
        "Prototypes/Issue{issue}"
      ],
      "cwd": ".",
      "healthPath": "/",
      "publicPath": "/",
      "identityTokens": [
        "http.server",
        "{port}",
        "Prototypes/Issue{issue}"
      ]
    }
  ]
}
